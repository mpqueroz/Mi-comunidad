{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.@(js|css|html|webmanifest)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "ignore": ["node_modules", ".git", "*.local", "serviceAccountKey.json"]
    }
  ],
  "emulators": {
    "auth": {"port": 9099},
    "firestore": {"port": 8080},
    "storage": {"port": 9199},
    "hosting": {"port": 5000},
    "ui": {"enabled": true}
  }
}
