rules_version = '2';

// Fotos del álbum: solo miembros de la familia pueden subir, ver o borrar.
service firebase.storage {
  match /b/{bucket}/o {
    match /families/{fid}/fotos/{file} {
      function isMember() {
        return request.auth != null
          && firestore.exists(/databases/(default)/documents/families/$(fid)/members/$(request.auth.uid));
      }
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isMember();
    }
  }
}
